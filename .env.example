# Application
NODE_ENV=development
PORT=3000

# MongoDB
# Format: mongodb://user:password@host:port/dbname?authSource=admin
MONGODB_URI=mongodb://root:password@localhost:27017/taskmanager?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379

# Session
# Must be at least 32 characters — rotate in production
SESSION_SECRET=change-this-to-a-random-32-char-secret-minimum
SESSION_EXPIRY_SECONDS=86400

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Login Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION_SECONDS=900
